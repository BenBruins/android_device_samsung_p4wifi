-#
-# system.prop for p4wifi (Nougat optimized)
-#
-
-# Graphics (Tegra 2 optimalisaties)
-ro.opengles.version = 131072
-ro.bq.gpu_to_cpu_unsupported = 1
-persist.sys.force_sw_gles = 0
-persist.sys.ui.hw = 1
-debug.egl.hw = 1
-debug.composition.type = dyn
-debug.sf.no_hw_vsync = 1
-
-# LCD Density (Perfect voor de 10.1 inch resolutie)
-ro.sf.lcd_density = 160
-
-# Low RAM optimalisaties (Essentieel voor 1GB)
-ro.config.low_ram = true
-persist.sys.purgeable_assets = 1
-
-# Wifi/Netwerk (Omdat p4wifi geen simslot heeft)
-ro.carrier = wifi-only
-rild.libpath = /system/lib/libsec-ril-apalone.so
-rild.libargs = -d /dev/ttyS0
-
-# Audio tweaks
-ro.config.vc_call_vol_steps = 15
-ro.config.media_vol_steps = 30
-
-# Disable boot animation (Kan helpen bij traag opstarten)
-debug.sf.nobootanimation = 0
